# Environment variables for compose.
# Uncomment and edit the variables you want to override.

# Location where output media files are saved.
#YPB_MEDIA_DIR=./media

# Path to your yt-dlp config location.
# Must be a literal path: shell variables like $HOME or ~ are not expanded.
#
# Linux:   YPB_YTDLP_CONFIG_DIR=/home/youruser/.config/yt-dlp
# macOS:   YPB_YTDLP_CONFIG_DIR=/Users/youruser/.config/yt-dlp
# Windows: YPB_YTDLP_CONFIG_DIR=C:/Users/youruser/.config/yt-dlp
#YPB_YTDLP_CONFIG_DIR=
